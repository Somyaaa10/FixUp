# Database & Server Settings
PORT=8001
# Provide either MONGO_URL or MONGODB_URI (e.g., MongoDB Atlas connection string)
MONGO_URL=mongodb://127.0.0.1:27017/fixup
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/fixup?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_SITE_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Admin Initial Seed Credentials
ADMIN_EMAIL=admin@fixup.com
ADMIN_PASSWORD=Password123!

# Payment Gateway (Razorpay API Keys)
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_key_secret

# Media Cloud Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_api_key
CLOUDINARY_API_SECRET=replace_with_api_secret